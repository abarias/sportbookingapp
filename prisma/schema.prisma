generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum FacilityType {
  BASKETBALL_WHOLE
  BASKETBALL_HALF
  PICKLEBALL
  BADMINTON
  OTHER
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  MANUAL
  MOCK
  PAYMONGO
}

enum PaymentStatus {
  AWAITING_PAYMENT
  SUBMITTED
  VERIFIED
  REJECTED
  ACTION_REQUIRED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PricingBillingMode {
  PER_HOUR
  PER_BLOCK
}

enum PricingDayType {
  DEFAULT
  WEEKDAY
  WEEKEND
  HOLIDAY
  SELECTED_DAYS
}

enum BookingRescheduleStatus {
  ADDITIONAL_PAYMENT_REQUIRED
  PAYMENT_SUBMITTED
  COMPLETED
  REJECTED
  EXPIRED
}

enum PriceAdjustmentType {
  SAME_PRICE
  LOWER_PRICE
  HIGHER_PRICE
}

enum PriceAdjustmentStatus {
  NONE
  UNRESOLVED
  ADDITIONAL_PAYMENT_REQUIRED
  SUBMITTED
  RESOLVED
  WAIVED
  REJECTED
  EXPIRED
}

enum PriceAdjustmentResolution {
  MANUAL_REFUND
  CUSTOMER_CREDIT
  NO_REFUND
  OTHER
  WAIVER
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  EXPIRED
  ABANDONED
}

enum BookingOrderStatus {
  PENDING_PAYMENT
  PROOF_SUBMITTED
  ACTION_REQUIRED
  CONFIRMED
  PAYMENT_REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentAllocationType {
  CHECKOUT
}

model User {
  id                         String                   @id @default(cuid())
  email                      String                   @unique
  passwordHash               String
  fullName                   String
  phone                      String?
  emailVerifiedAt            DateTime?
  phoneVerifiedAt            DateTime?
  role                       UserRole                 @default(CUSTOMER)
  adminAccessActive          Boolean                  @default(false)
  bookings                   Booking[]
  createdBlocks              BlockedSchedule[]        @relation("BlockedScheduleCreator")
  verifiedPayments           Payment[]                @relation("PaymentVerifier")
  otpRequests                OtpRequest[]
  emailVerificationTokens    EmailVerificationToken[]
  passwordResetTokens        PasswordResetToken[]
  registrationAttempts       RegistrationAttempt[]
  createdPricingRules        PricingRule[]            @relation("PricingRuleCreator")
  updatedPricingRules        PricingRule[]            @relation("PricingRuleUpdater")
  createdHolidays            Holiday[]                @relation("HolidayCreator")
  updatedHolidays            Holiday[]                @relation("HolidayUpdater")
  roleAssignments            UserRoleAssignment[]     @relation("AssignedUserRoles")
  assignedRoleAssignments    UserRoleAssignment[]     @relation("UserRoleAssigner")
  createdRoles               Role[]                   @relation("RoleCreator")
  updatedRoles               Role[]                   @relation("RoleUpdater")
  assignedRolePermissions    RolePermission[]         @relation("RolePermissionAssigner")
  auditLogs                  AuditLog[]               @relation("AuditActor")
  initiatedReschedules       BookingReschedule[]      @relation("RescheduleInitiator")
  finalizedReschedules       BookingReschedule[]      @relation("RescheduleFinalizer")
  resolvedReschedules        BookingReschedule[]      @relation("RescheduleResolver")
  verifiedReschedulePayments ReschedulePayment[]      @relation("ReschedulePaymentVerifier")
  notificationDeliveries     NotificationDelivery[]
  accountInboxViewedAt       DateTime?
  carts                      Cart[]
  bookingOrders              BookingOrder[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@index([role])
  @@index([phone])
  @@index([emailVerifiedAt])
}

model Role {
  id              String               @id @default(cuid())
  systemKey       String?              @unique
  name            String               @unique
  description     String
  isSystem        Boolean              @default(false)
  isProtected     Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  createdBy       User?                @relation("RoleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?                @relation("RoleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  permissions     RolePermission[]
  users           UserRoleAssignment[]

  @@index([isActive])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  displayName String
  description String
  category    String
  riskLevel   String           @default("STANDARD")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([category, isActive])
}

model RolePermission {
  roleId           String
  permissionId     String
  assignedByUserId String?
  assignedAt       DateTime   @default(now())
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission       Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedBy       User?      @relation("RolePermissionAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime @default(now())
  user             User     @relation("AssignedUserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy       User?    @relation("UserRoleAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Facility {
  id                              String                  @id @default(cuid())
  name                            String
  slug                            String                  @unique
  description                     String
  type                            FacilityType
  timezone                        String                  @default("Asia/Manila")
  isEnabled                       Boolean                 @default(true)
  slotIntervalMinutes             Int                     @default(30)
  cancellationEnabledOverride     Boolean?
  cancellationWindowHoursOverride Int?
  images                          FacilityImage[]
  operatingHours                  FacilityOperatingHour[]
  pricingRules                    PricingRule[]
  bookings                        Booking[]
  blockedSchedules                BlockedSchedule[]
  holidays                        Holiday[]
  originalReschedules             BookingReschedule[]     @relation("OriginalRescheduleFacility")
  replacementReschedules          BookingReschedule[]     @relation("ReplacementRescheduleFacility")
  cartItems                       CartItem[]
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt

  @@index([type, isEnabled])
}

model OtpRequest {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([phone])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model RegistrationAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  ipHash    String?
  outcome   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([outcome, createdAt])
}

model RateLimitBucket {
  id           String   @id @default(cuid())
  action       String
  subjectHash  String
  windowStart  DateTime
  attempts     Int      @default(1)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([action, subjectHash, windowStart])
  @@index([expiresAt])
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  url        String
  altText    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, sortOrder])
}

model FacilityOperatingHour {
  id              String   @id @default(cuid())
  facilityId      String
  dayOfWeek       Int
  opensAtMinutes  Int
  closesAtMinutes Int
  isClosed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, dayOfWeek])
  @@index([facilityId])
}

model PricingRule {
  id              String             @id @default(cuid())
  facilityId      String
  name            String             @default("Default rate")
  customerLabel   String?
  dayType         PricingDayType     @default(DEFAULT)
  daysOfWeek      Int[]              @default([])
  startMinutes    Int                @default(0)
  endMinutes      Int                @default(1440)
  currency        String             @default("PHP")
  amountMinor     Int
  billingMode     PricingBillingMode @default(PER_HOUR)
  minimumMinutes  Int                @default(60)
  priority        Int                @default(0)
  effectiveFrom   DateTime?          @db.Date
  effectiveUntil  DateTime?          @db.Date
  isActive        Boolean            @default(true)
  displayOrder    Int                @default(0)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  facility        Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User?              @relation("PricingRuleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?              @relation("PricingRuleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([facilityId, isActive, dayType])
  @@index([facilityId, effectiveFrom, effectiveUntil])
}

model Holiday {
  id              String    @id @default(cuid())
  facilityId      String?
  name            String
  date            DateTime  @db.Date
  isActive        Boolean   @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  facility        Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("HolidayCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?     @relation("HolidayUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([facilityId, date, name])
  @@index([date, isActive])
  @@index([facilityId, date, isActive])
}

model Booking {
  id                     String                 @id @default(cuid())
  reference              String?                @unique
  userId                 String
  facilityId             String
  bookingOrderId         String?
  orderItemSequence      Int?
  status                 BookingStatus
  startAtUtc             DateTime
  endAtUtc               DateTime
  timezone               String                 @default("Asia/Manila")
  slotCount              Int
  amountMinor            Int
  currency               String                 @default("PHP")
  priceSnapshot          Json?
  idempotencyKey         String?                @unique
  paymentHoldExpiresAt   DateTime?
  cancellationReason     String?
  cancelledAt            DateTime?
  payment                Payment?
  paymentAllocations     PaymentAllocation[]
  reschedules            BookingReschedule[]
  notificationDeliveries NotificationDelivery[]
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility               Facility               @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  bookingOrder           BookingOrder?          @relation(fields: [bookingOrderId], references: [id], onDelete: Restrict)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([bookingOrderId, orderItemSequence])
  @@index([facilityId, startAtUtc, endAtUtc])
  @@index([userId, startAtUtc])
  @@index([status, paymentHoldExpiresAt])
  @@index([bookingOrderId, orderItemSequence])
}

model Payment {
  id                          String              @id @default(cuid())
  bookingId                   String?             @unique
  bookingOrderId              String?             @unique
  provider                    PaymentProvider
  providerReference           String?             @unique
  method                      String?
  externalReference           String?
  normalizedExternalReference String?
  amountPaidMinor             Int?
  proofImageUrl               String?
  checkoutUrl                 String?
  status                      PaymentStatus
  amountMinor                 Int
  currency                    String              @default("PHP")
  paidAt                      DateTime?
  submittedAt                 DateTime?
  verifiedAt                  DateTime?
  verifiedByUserId            String?
  rejectedAt                  DateTime?
  actionRequiredAt            DateTime?
  expiresAt                   DateTime?
  reviewNote                  String?
  duplicateReference          Boolean             @default(false)
  rawPayload                  Json?
  booking                     Booking?            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingOrder                BookingOrder?       @relation(fields: [bookingOrderId], references: [id], onDelete: Cascade)
  allocations                 PaymentAllocation[]
  verifiedBy                  User?               @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  originalForReschedules      BookingReschedule[] @relation("OriginalReschedulePayment")
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  @@index([status, expiresAt])
  @@index([normalizedExternalReference, status])
}

model Cart {
  id             String        @id @default(cuid())
  userId         String
  status         CartStatus    @default(ACTIVE)
  currency       String        @default("PHP")
  version        Int           @default(1)
  lastActivityAt DateTime      @default(now())
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]
  bookingOrder   BookingOrder?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CartItem {
  id                 String   @id @default(cuid())
  cartId             String
  facilityId         String
  dateKey            String
  startAtUtc         DateTime
  endAtUtc           DateTime
  timezone           String   @default("Asia/Manila")
  durationMinutes    Int
  quotedAmountMinor  Int
  currency           String   @default("PHP")
  quotedPricePreview Json
  quoteCalculatedAt  DateTime
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  cart               Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  facility           Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([cartId, facilityId, startAtUtc, endAtUtc])
  @@index([cartId, createdAt])
  @@index([facilityId, startAtUtc, endAtUtc])
}

model BookingOrder {
  id                     String                 @id @default(cuid())
  userId                 String
  cartId                 String                 @unique
  reference              String                 @unique
  status                 BookingOrderStatus     @default(PENDING_PAYMENT)
  currency               String                 @default("PHP")
  vatTreatment           String                 @default("VAT_EXCLUSIVE")
  baseAmountMinor        Int
  amountPaidMinor        Int?
  outstandingAmountMinor Int
  checkoutSnapshot       Json
  checkoutAt             DateTime               @default(now())
  paymentDeadline        DateTime?
  proofSubmittedAt       DateTime?
  verifiedAt             DateTime?
  rejectedAt             DateTime?
  expiredAt              DateTime?
  cancelledAt            DateTime?
  idempotencyKey         String                 @unique
  version                Int                    @default(1)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  cart                   Cart                   @relation(fields: [cartId], references: [id], onDelete: Restrict)
  bookings               Booking[]
  payment                Payment?
  paymentAllocations     PaymentAllocation[]
  notificationDeliveries NotificationDelivery[]

  @@index([userId, createdAt])
  @@index([status, paymentDeadline])
}

model PaymentAllocation {
  id             String                @id @default(cuid())
  paymentId      String
  bookingOrderId String
  bookingId      String
  amountMinor    Int
  currency       String                @default("PHP")
  type           PaymentAllocationType @default(CHECKOUT)
  createdAt      DateTime              @default(now())
  payment        Payment               @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  bookingOrder   BookingOrder          @relation(fields: [bookingOrderId], references: [id], onDelete: Restrict)
  booking        Booking               @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@unique([paymentId, bookingId])
  @@index([bookingOrderId, bookingId])
  @@index([bookingId])
}

model BookingReschedule {
  id                       String                     @id @default(cuid())
  bookingId                String
  originalPaymentId        String?
  originalBookingReference String
  originalFacilityId       String
  originalStartAtUtc       DateTime
  originalEndAtUtc         DateTime
  originalTimezone         String
  replacementFacilityId    String
  replacementStartAtUtc    DateTime
  replacementEndAtUtc      DateTime
  replacementTimezone      String
  originalPriceSnapshot    Json?
  replacementPriceSnapshot Json
  originalAmountMinor      Int
  replacementAmountMinor   Int
  priceDifferenceMinor     Int
  waivedAmountMinor        Int                        @default(0)
  additionalAmountDueMinor Int                        @default(0)
  currency                 String                     @default("PHP")
  status                   BookingRescheduleStatus
  adjustmentType           PriceAdjustmentType
  adjustmentStatus         PriceAdjustmentStatus
  holdExpiresAt            DateTime?
  reason                   String
  internalNote             String?
  customerNote             String?
  resolutionMethod         PriceAdjustmentResolution?
  resolutionAmountMinor    Int?
  resolutionReference      String?
  resolutionNote           String?
  initiatedByUserId        String
  finalizedByUserId        String?
  resolvedByUserId         String?
  idempotencyKey           String                     @unique
  version                  Int                        @default(1)
  finalizedAt              DateTime?
  rejectedAt               DateTime?
  expiredAt                DateTime?
  resolvedAt               DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  booking                  Booking                    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  originalPayment          Payment?                   @relation("OriginalReschedulePayment", fields: [originalPaymentId], references: [id], onDelete: SetNull)
  originalFacility         Facility                   @relation("OriginalRescheduleFacility", fields: [originalFacilityId], references: [id], onDelete: Restrict)
  replacementFacility      Facility                   @relation("ReplacementRescheduleFacility", fields: [replacementFacilityId], references: [id], onDelete: Restrict)
  initiatedBy              User                       @relation("RescheduleInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  finalizedBy              User?                      @relation("RescheduleFinalizer", fields: [finalizedByUserId], references: [id], onDelete: SetNull)
  resolvedBy               User?                      @relation("RescheduleResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  additionalPayment        ReschedulePayment?
  notificationDeliveries   NotificationDelivery[]

  @@index([bookingId, createdAt])
  @@index([status, holdExpiresAt])
  @@index([replacementFacilityId, replacementStartAtUtc, replacementEndAtUtc])
  @@index([adjustmentStatus, createdAt])
}

model ReschedulePayment {
  id                          String            @id @default(cuid())
  bookingRescheduleId         String            @unique
  provider                    PaymentProvider   @default(MANUAL)
  providerReference           String            @unique
  method                      String?
  externalReference           String?
  normalizedExternalReference String?
  amountMinor                 Int
  currency                    String            @default("PHP")
  proofImageUrl               String?
  status                      PaymentStatus
  submittedAt                 DateTime?
  verifiedAt                  DateTime?
  verifiedByUserId            String?
  rejectedAt                  DateTime?
  reviewNote                  String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  bookingReschedule           BookingReschedule @relation(fields: [bookingRescheduleId], references: [id], onDelete: Cascade)
  verifiedBy                  User?             @relation("ReschedulePaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([normalizedExternalReference, status])
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  dedupeKey      String                     @unique
  userId         String
  bookingId      String?
  bookingOrderId String?
  rescheduleId   String?
  eventType      String
  payload        Json
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  booking        Booking?                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingOrder   BookingOrder?              @relation(fields: [bookingOrderId], references: [id], onDelete: Cascade)
  reschedule     BookingReschedule?         @relation(fields: [rescheduleId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([bookingId, createdAt])
  @@index([bookingOrderId, createdAt])
}

model BlockedSchedule {
  id              String   @id @default(cuid())
  facilityId      String
  title           String
  reason          String?
  startAtUtc      DateTime
  endAtUtc        DateTime
  createdByUserId String
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("BlockedScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([facilityId, startAtUtc, endAtUtc])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
