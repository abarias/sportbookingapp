generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum FacilityType {
  BASKETBALL_WHOLE
  BASKETBALL_HALF
  PICKLEBALL
  BADMINTON
  OTHER
}

enum BookingStatus {
  HELD
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  MANUAL
  MOCK
  PAYMONGO
}

enum PaymentStatus {
  AWAITING_PAYMENT
  SUBMITTED
  VERIFIED
  REJECTED
  ACTION_REQUIRED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

enum PricingBillingMode {
  PER_HOUR
  PER_BLOCK
}

enum PricingDayType {
  DEFAULT
  WEEKDAY
  WEEKEND
  HOLIDAY
  SELECTED_DAYS
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  fullName                String
  phone                   String?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  role                    UserRole                 @default(CUSTOMER)
  bookings                Booking[]
  createdBlocks           BlockedSchedule[]        @relation("BlockedScheduleCreator")
  verifiedPayments        Payment[]                @relation("PaymentVerifier")
  otpRequests             OtpRequest[]
  emailVerificationTokens EmailVerificationToken[]
  registrationAttempts    RegistrationAttempt[]
  createdPricingRules     PricingRule[]            @relation("PricingRuleCreator")
  updatedPricingRules     PricingRule[]            @relation("PricingRuleUpdater")
  createdHolidays         Holiday[]                @relation("HolidayCreator")
  updatedHolidays         Holiday[]                @relation("HolidayUpdater")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([role])
  @@index([phone])
  @@index([emailVerifiedAt])
}

model Facility {
  id                              String                  @id @default(cuid())
  name                            String
  slug                            String                  @unique
  description                     String
  type                            FacilityType
  timezone                        String                  @default("Asia/Manila")
  isEnabled                       Boolean                 @default(true)
  slotIntervalMinutes             Int                     @default(30)
  cancellationEnabledOverride     Boolean?
  cancellationWindowHoursOverride Int?
  images                          FacilityImage[]
  operatingHours                  FacilityOperatingHour[]
  pricingRules                    PricingRule[]
  bookings                        Booking[]
  blockedSchedules                BlockedSchedule[]
  holidays                        Holiday[]
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt

  @@index([type, isEnabled])
}

model OtpRequest {
  id         String    @id @default(cuid())
  userId     String
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([phone])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String
  attempts   Int       @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([email])
}

model RegistrationAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  ipHash    String?
  outcome   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipHash, createdAt])
  @@index([outcome, createdAt])
}

model FacilityImage {
  id         String   @id @default(cuid())
  facilityId String
  url        String
  altText    String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId, sortOrder])
}

model FacilityOperatingHour {
  id              String   @id @default(cuid())
  facilityId      String
  dayOfWeek       Int
  opensAtMinutes  Int
  closesAtMinutes Int
  isClosed        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, dayOfWeek])
  @@index([facilityId])
}

model PricingRule {
  id              String             @id @default(cuid())
  facilityId      String
  name            String             @default("Default rate")
  customerLabel   String?
  dayType         PricingDayType     @default(DEFAULT)
  daysOfWeek      Int[]              @default([])
  startMinutes    Int                @default(0)
  endMinutes      Int                @default(1440)
  currency        String             @default("PHP")
  amountMinor     Int
  billingMode     PricingBillingMode @default(PER_HOUR)
  minimumMinutes  Int                @default(60)
  priority        Int                @default(0)
  effectiveFrom   DateTime?          @db.Date
  effectiveUntil  DateTime?          @db.Date
  isActive        Boolean            @default(true)
  displayOrder    Int                @default(0)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  facility        Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User?              @relation("PricingRuleCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?              @relation("PricingRuleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([facilityId, isActive, dayType])
  @@index([facilityId, effectiveFrom, effectiveUntil])
}

model Holiday {
  id              String    @id @default(cuid())
  facilityId      String?
  name            String
  date            DateTime  @db.Date
  isActive        Boolean   @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  facility        Facility? @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("HolidayCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?     @relation("HolidayUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([facilityId, date, name])
  @@index([date, isActive])
  @@index([facilityId, date, isActive])
}

model Booking {
  id                   String        @id @default(cuid())
  userId               String
  facilityId           String
  status               BookingStatus
  startAtUtc           DateTime
  endAtUtc             DateTime
  timezone             String        @default("Asia/Manila")
  slotCount            Int
  amountMinor          Int
  currency             String        @default("PHP")
  priceSnapshot        Json?
  idempotencyKey       String?       @unique
  paymentHoldExpiresAt DateTime?
  cancellationReason   String?
  cancelledAt          DateTime?
  payment              Payment?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility             Facility      @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([facilityId, startAtUtc, endAtUtc])
  @@index([userId, startAtUtc])
  @@index([status, paymentHoldExpiresAt])
}

model Payment {
  id                          String          @id @default(cuid())
  bookingId                   String          @unique
  provider                    PaymentProvider
  providerReference           String?         @unique
  method                      String?
  externalReference           String?
  normalizedExternalReference String?
  amountPaidMinor             Int?
  proofImageUrl               String?
  checkoutUrl                 String?
  status                      PaymentStatus
  amountMinor                 Int
  currency                    String          @default("PHP")
  paidAt                      DateTime?
  submittedAt                 DateTime?
  verifiedAt                  DateTime?
  verifiedByUserId            String?
  rejectedAt                  DateTime?
  actionRequiredAt            DateTime?
  expiresAt                   DateTime?
  reviewNote                  String?
  duplicateReference          Boolean         @default(false)
  rawPayload                  Json?
  booking                     Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  verifiedBy                  User?           @relation("PaymentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@index([status, expiresAt])
  @@index([normalizedExternalReference, status])
}

model BlockedSchedule {
  id              String   @id @default(cuid())
  facilityId      String
  title           String
  reason          String?
  startAtUtc      DateTime
  endAtUtc        DateTime
  createdByUserId String
  facility        Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  createdBy       User     @relation("BlockedScheduleCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([facilityId, startAtUtc, endAtUtc])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}
